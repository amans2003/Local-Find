{
  "name": "localfind",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm i --prefix server && npm i --prefix client && npm i --prefix admin",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev:admin": "npm run dev --prefix admin",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:admin\"",
    "build:client": "npm run build --prefix client",
    "build:admin": "npm run build --prefix admin",
    "seed": "node server/utils/seed.js",
    "test": "npm test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
