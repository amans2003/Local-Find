\NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/localfind
REDIS_URL=redis://localhost:6379

JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

SENDGRID_API_KEY=SG.xxxx
SMTP_FROM_EMAIL=noreply@localfind.in
SMTP_FROM_NAME=LocalFind

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

MSG91_API_KEY=your_msg91_key
MSG91_SENDER_ID=LCLFND
MSG91_TEMPLATE_ID=your_template_id

ADMIN_EMAIL=admin@localfind.in
ADMIN_INITIAL_PASSWORD=Admin@1234!
